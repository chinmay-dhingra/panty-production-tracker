{
  "name": "ProductSize",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Size name e.g. S, M, L, XL"
    },
    "sort_order": {
      "type": "number",
      "description": "Order for display"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}