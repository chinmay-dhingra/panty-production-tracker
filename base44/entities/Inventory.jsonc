      "type": "string"
    },
    "color_id": {
      "type": "string"
    },
    "color_name": {
      "type": "string"
    },
    "size_id": {
      "type": "string"
    },
    "size_name": {
      "type": "string"
    },
    "material_id": {
      "type": "string"
    },
    "material_name": {
      "type": "string"
    },
