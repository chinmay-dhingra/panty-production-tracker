{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Vendor / fabricator name"
    },
    "type": {
      "type": "string",
      "enum": [
        "fabricator",
        "supplier",
        "vendor"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "fabricator",
      "description": "Kind of external party"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}