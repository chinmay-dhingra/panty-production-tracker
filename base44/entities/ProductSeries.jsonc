{
  "name": "ProductSeries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product series name e.g. Classic, Premium"
    },
    "code": {
      "type": "string",
      "description": "Short code for the series"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}