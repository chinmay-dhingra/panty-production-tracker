{
  "name": "ProductColor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Color name e.g. Black, White, Red"
    },
    "code": {
      "type": "string",
      "description": "Short code for the color"
    },
    "hex_code": {
      "type": "string",
      "description": "Hex color code for display"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}